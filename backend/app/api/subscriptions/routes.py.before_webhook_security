import hashlib
import hmac
import json
import logging
from datetime import datetime, timedelta, timezone
from uuid import uuid4

from fastapi import APIRouter, Depends, HTTPException, Request, status
from pydantic import BaseModel, Field
from pymongo import ReturnDocument

from app.config import settings
from app.database.connection import get_database
from app.dependencies import require_role

logger = logging.getLogger(__name__)

router = APIRouter(
    prefix="/api/subscriptions",
    tags=["Subscriptions"],
)

db = get_database()


class CreateOrderRequest(BaseModel):
    plan: str = Field(pattern="^(monthly|yearly)$")


class VerifyPaymentRequest(BaseModel):
    razorpay_order_id: str = Field(min_length=1, max_length=200)
    razorpay_payment_id: str = Field(min_length=1, max_length=200)
    razorpay_signature: str = Field(min_length=1, max_length=500)


def _now():
    return datetime.now(timezone.utc)


def _plan_details(plan: str):
    if plan == "monthly":
        return {
            "plan": "monthly",
            "amount": settings.subscription_monthly_price_paise,
            "duration_days": 30,
        }

    if plan == "yearly":
        return {
            "plan": "yearly",
            "amount": settings.subscription_yearly_price_paise,
            "duration_days": 365,
        }

    raise HTTPException(status_code=400, detail="Invalid subscription plan")


def _require_razorpay_config():
    if not settings.razorpay_key_id or not settings.razorpay_key_secret:
        raise HTTPException(
            status_code=status.HTTP_503_SERVICE_UNAVAILABLE,
            detail="Razorpay is not configured. Set the server environment keys.",
        )


def _safe_subscription(record):
    if not record:
        return None

    return {
        "id": str(record["_id"]),
        "plan": record.get("plan"),
        "status": record.get("status"),
        "starts_at": record.get("starts_at"),
        "expires_at": record.get("expires_at"),
        "created_at": record.get("created_at"),
    }


@router.get("/plans")
def get_plans():
    return {
        "success": True,
        "currency": settings.subscription_currency,
        "free_opportunities": settings.worker_free_opportunities,
        "plans": [
            {
                **_plan_details("monthly"),
                "amount_rupees": settings.subscription_monthly_price_paise / 100,
            },
            {
                **_plan_details("yearly"),
                "amount_rupees": settings.subscription_yearly_price_paise / 100,
            },
        ],
    }


@router.get("/me")
def get_my_subscription(
    current_user: dict = Depends(require_role("worker")),
):
    worker_id = current_user["user_id"]
    worker = db["workers"].find_one({"user_id": worker_id})

    if not worker:
        raise HTTPException(status_code=404, detail="Create your worker profile first")

    now = _now()
    subscription = db["subscriptions"].find_one(
        {
            "worker_id": worker_id,
            "status": "active",
            "expires_at": {"$gt": now},
        },
        sort=[("expires_at", -1)],
    )

    used = int(worker.get("free_opportunities_used", 0))
    total = settings.worker_free_opportunities

    return {
        "success": True,
        "free_opportunities": {
            "total": total,
            "used": used,
            "remaining": max(0, total - used),
        },
        "subscription": _safe_subscription(subscription),
        "has_paid_access": subscription is not None,
    }


@router.post("/create-order")
def create_order(
    data: CreateOrderRequest,
    current_user: dict = Depends(require_role("worker")),
):
    _require_razorpay_config()

    worker = db["workers"].find_one({"user_id": current_user["user_id"]})
    if not worker:
        raise HTTPException(status_code=404, detail="Create your worker profile first")

    plan = _plan_details(data.plan)

    try:
        import requests

        response = requests.post(
            "https://api.razorpay.com/v1/orders",
            auth=(settings.razorpay_key_id, settings.razorpay_key_secret),
            json={
                "amount": plan["amount"],
                "currency": settings.subscription_currency,
                "receipt": f"solvix_{uuid4().hex[:24]}",
                "notes": {
                    "worker_id": current_user["user_id"],
                    "plan": data.plan,
                },
            },
            timeout=20,
        )

        if response.status_code not in (200, 201):
            logger.error("Razorpay order creation failed: HTTP %s", response.status_code)
            raise HTTPException(
                status_code=502,
                detail="Could not create payment order. Please try again.",
            )

        order = response.json()

        db["payments"].update_one(
            {"razorpay_order_id": order["id"]},
            {
                "$setOnInsert": {
                    "worker_id": current_user["user_id"],
                    "plan": data.plan,
                    "amount": plan["amount"],
                    "currency": settings.subscription_currency,
                    "razorpay_order_id": order["id"],
                    "status": "created",
                    "created_at": _now(),
                }
            },
            upsert=True,
        )

        return {
            "success": True,
            "key_id": settings.razorpay_key_id,
            "order_id": order["id"],
            "amount": order["amount"],
            "currency": order["currency"],
            "plan": data.plan,
        }

    except HTTPException:
        raise
    except Exception:
        logger.exception("Razorpay order creation error")
        raise HTTPException(status_code=502, detail="Payment provider is unavailable")


def _activate_verified_payment(order_id: str, payment_id: str):
    payment = db["payments"].find_one({"razorpay_order_id": order_id})

    if not payment:
        raise HTTPException(status_code=404, detail="Payment order not found")

    if payment.get("razorpay_payment_id") not in (None, payment_id):
        raise HTTPException(status_code=409, detail="Payment order already has another payment")

    if payment.get("status") == "verified":
        subscription = db["subscriptions"].find_one(
            {"payment_id": payment_id}
        )
        return {
            "success": True,
            "message": "Payment already verified",
            "subscription": _safe_subscription(subscription),
        }

    now = _now()
    plan = _plan_details(payment["plan"])
    worker_id = payment["worker_id"]

    active = db["subscriptions"].find_one(
        {
            "worker_id": worker_id,
            "status": "active",
            "expires_at": {"$gt": now},
        },
        sort=[("expires_at", -1)],
    )

    starts_at = active["expires_at"] if active else now
    expires_at = starts_at + timedelta(days=plan["duration_days"])

    subscription_doc = {
        "worker_id": worker_id,
        "plan": payment["plan"],
        "status": "active",
        "payment_id": payment_id,
        "razorpay_order_id": order_id,
        "starts_at": starts_at,
        "expires_at": expires_at,
        "created_at": now,
        "updated_at": now,
    }

    # Prevent duplicate activation if verification/webhook is retried.
    db["subscriptions"].update_one(
        {"payment_id": payment_id},
        {"$setOnInsert": subscription_doc},
        upsert=True,
    )

    db["payments"].update_one(
        {
            "razorpay_order_id": order_id,
            "status": {"$ne": "verified"},
        },
        {
            "$set": {
                "razorpay_payment_id": payment_id,
                "status": "verified",
                "verified_at": now,
                "updated_at": now,
            }
        },
    )

    saved = db["subscriptions"].find_one({"payment_id": payment_id})

    return {
        "success": True,
        "message": "Payment verified and subscription activated",
        "subscription": _safe_subscription(saved),
    }


@router.post("/verify-payment")
def verify_payment(
    data: VerifyPaymentRequest,
    current_user: dict = Depends(require_role("worker")),
):
    _require_razorpay_config()

    payment = db["payments"].find_one(
        {
            "razorpay_order_id": data.razorpay_order_id,
            "worker_id": current_user["user_id"],
        }
    )

    if not payment:
        raise HTTPException(status_code=404, detail="Payment order not found")

    expected = hmac.new(
        settings.razorpay_key_secret.encode(),
        f"{data.razorpay_order_id}|{data.razorpay_payment_id}".encode(),
        hashlib.sha256,
    ).hexdigest()

    if not hmac.compare_digest(expected, data.razorpay_signature):
        raise HTTPException(status_code=400, detail="Invalid payment signature")

    # Verify payment independently with Razorpay before activating access.
    try:
        provider_response = requests.get(
            f"https://api.razorpay.com/v1/payments/"
            f"{data.razorpay_payment_id}",
            auth=(
                settings.razorpay_key_id,
                settings.razorpay_key_secret,
            ),
            timeout=15,
        )
    except requests.RequestException:
        logger.exception("Razorpay payment verification request failed")
        raise HTTPException(
            status_code=502,
            detail="Could not verify payment with the payment provider. Please retry.",
        )

    if provider_response.status_code != 200:
        logger.error(
            "Razorpay payment lookup failed with HTTP %s",
            provider_response.status_code,
        )
        raise HTTPException(
            status_code=502,
            detail="Payment provider verification failed. Please retry.",
        )

    try:
        provider_payment = provider_response.json()
    except ValueError:
        raise HTTPException(
            status_code=502,
            detail="Invalid response from payment provider",
        )

    if (
        provider_payment.get("id") != data.razorpay_payment_id
        or provider_payment.get("order_id") != data.razorpay_order_id
        or provider_payment.get("status") != "captured"
        or provider_payment.get("captured") is not True
        or provider_payment.get("amount") != payment.get("amount")
        or provider_payment.get("currency") != payment.get("currency")
    ):
        raise HTTPException(
            status_code=400,
            detail=(
                "Payment is not captured or its order, amount, "
                "or currency does not match."
            ),
        )

    return _activate_verified_payment(
        data.razorpay_order_id,
        data.razorpay_payment_id,
    )


@router.post("/webhook")
async def razorpay_webhook(request: Request):
    secret = settings.razorpay_webhook_secret

    if not secret:
        raise HTTPException(
            status_code=503,
            detail="Razorpay webhook is not configured",
        )

    body = await request.body()
    signature = request.headers.get("X-Razorpay-Signature", "")

    expected = hmac.new(
        secret.encode(),
        body,
        hashlib.sha256,
    ).hexdigest()

    if not signature or not hmac.compare_digest(expected, signature):
        raise HTTPException(status_code=400, detail="Invalid webhook signature")

    try:
        event = json.loads(body)
    except ValueError:
        raise HTTPException(status_code=400, detail="Invalid webhook payload")

    event_id = request.headers.get("X-Razorpay-Event-Id")

    if event_id:
        inserted = db["payment_webhook_events"].update_one(
            {"event_id": event_id},
            {"$setOnInsert": {"event_id": event_id, "received_at": _now()}},
            upsert=True,
        )
        if inserted.upserted_id is None:
            return {"success": True, "message": "Duplicate event ignored"}

    if event.get("event") == "payment.captured":
        entity = (
            event.get("payload", {})
            .get("payment", {})
            .get("entity", {})
        )
        order_id = entity.get("order_id")
        payment_id = entity.get("id")

        if order_id and payment_id:
            payment = db["payments"].find_one({"razorpay_order_id": order_id})
            if payment and payment.get("status") != "verified":
                # Webhook signature authenticates the event. Payment must also be captured.
                _activate_verified_payment(order_id, payment_id)

    return {"success": True}
